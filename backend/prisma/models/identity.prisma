model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(100)
  avatarKey    String?    @map("avatar_key") @db.VarChar(500)
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt          DateTime? @map("email_verified_at") @db.Timestamp(6)
  activationTokenHash      String?   @unique @map("activation_token_hash") @db.VarChar(64)
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at") @db.Timestamp(6)

  studentProfile StudentProfile?

  createdCourses Course[] @relation("CourseCreator")

  taughtClasses ClassTeacher[]
  enrollments   Enrollment[]

  lessonProgress LessonProgress[]

  createdAssignments Assignment[]           @relation("AssignmentCreator")
  submissions        AssignmentSubmission[] @relation("SubmissionStudent")
  gradedSubmissions  AssignmentSubmission[] @relation("SubmissionGrader")

  createdExams Exam[]        @relation("ExamCreator")
  examAttempts ExamAttempt[]

  createdQuestions Question[] @relation("QuestionCreator")

  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([role, status])
  @@map("users")
}

model StudentProfile {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @unique @map("user_id") @db.Uuid
  grade      GradeLevel? 
  schoolName String?     @map("school_name") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("student_profiles")
}
