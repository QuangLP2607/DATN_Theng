model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(100)
  avatar       String?    @db.VarChar(255)
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)

  taughtCourses  CourseTeacher[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]

  createdAssignments Assignment[]           @relation("AssignmentCreator")
  submissions        AssignmentSubmission[]
  gradedSubmissions AssignmentSubmission[]  @relation("SubmissionGrader")

  createdExams     Exam[]     @relation("ExamCreator")
  createdQuestions Question[] @relation("QuestionCreator")

  examAttempts  ExamAttempt[]
  notifications Notification[]

  emailVerifiedAt         DateTime? @map("email_verified_at") @db.Timestamp(6)
  activationTokenHash      String?   @unique @map("activation_token_hash") @db.VarChar(64)
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([role, status])
  @@map("users")
}