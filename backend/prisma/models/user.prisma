model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(100)
  avatar       String?    @db.VarChar(500)
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)

  // Classes
  taughtClasses ClassTeacher[]
  enrollments   Enrollment[]

  // Learning
  lessonProgress LessonProgress[]

  // Assignments
  createdAssignments Assignment[] @relation("AssignmentCreator")
  submissions        AssignmentSubmission[] @relation("SubmissionStudent")
  gradedSubmissions  AssignmentSubmission[] @relation("SubmissionGrader")

  // Exams
  createdExams Exam[] @relation("ExamCreator")
  examAttempts ExamAttempt[]

  // Questions
  createdQuestions Question[] @relation("QuestionCreator")

  // Notifications
  notifications Notification[]

  // Account activation
  emailVerifiedAt         DateTime? @map("email_verified_at") @db.Timestamp(6)
  activationTokenHash      String?   @unique @map("activation_token_hash") @db.VarChar(64)
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([role, status])
  @@map("users")
}